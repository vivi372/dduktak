# ==============================================================================
# 오늘의 뚝딱 (Dduktak) 전역 환경변수 템플릿 (.env.example)
# 복사하여 .env 파일을 생성한 뒤 실제 환경에 맞는 값을 입력하세요.
# 주의: 실제 .env 파일은 .gitignore에 포함되어 절대 Git에 커밋되지 않습니다.
# ==============================================================================

# --- [Backend] PostgreSQL / Supabase Database Connection (Render / Local 호환) ---
# 1) Render 프로덕션 배포 환경변수 규격
SPRING_DATASOURCE_URL=jdbc:log4jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.hefryhbaoovrhgzevfad
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# 2) 로컬 개발 환경 개별 변수 규격 (SPRING_DATASOURCE_* 미지정 시 Fallback 사용)
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.hefryhbaoovrhgzevfad
DB_PASSWORD=your_database_password_here

# --- [Backend] Spring Boot Server & Security ---
PORT=8080
# Supabase 대시보드 (Project Settings > API > JWT Settings > JWT Secret)
JWT_SECRET_KEY=your_supabase_jwt_secret_here
JWT_SECRET=your_supabase_jwt_secret_here

# --- [Backend] External Services (Gemini Flash Lite OCR) ---
# Google AI Studio Gemini API Key (영수증 OCR 품목 파싱용: POST /api/v1/inventory/scan-ocr)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# --- [Frontend] Supabase Client Direct Access (Vercel / Local 호환) ---
# 프로필 및 레시피 이미지 직접 업로드(Supabase Storage)를 위해 프론트엔드에 노출되는 공개 키
VITE_SUPABASE_URL=https://hefryhbaoovrhgzevfad.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here

# --- [Frontend] API Base URL & Site URL (Vercel / Android APK 연동) ---
# 1) 클라우드 배포 서버 구동 시: https://<your-backend-domain>.onrender.com
# 2) 동일 Wi-Fi 모바일 실기기 구동 시: http://<PC_로컬_IP>:8080
VITE_API_BASE_URL=http://10.0.2.2:8080
# 모바일 하이브리드 앱(APK)에서 소셜/이메일 인증 콜백 브릿지로 사용할 웹 배포 도메인 (예: https://dduktak.vercel.app)
VITE_SITE_URL=http://192.168.219.101:5173

# --- [Backend] Firebase Cloud Messaging (FCM 푸시 알림) ---
# 1) 파일 경로 지정 방식 (로컬 개발 환경 권장)
FIREBASE_SERVICE_ACCOUNT_PATH=backend/src/main/resources/firebase-service-account.json
# 2) JSON 문자열 직접 주입 방식 (Render 프로덕션 배포 환경 권장 - 단일 라인 JSON 문자열)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
