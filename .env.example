# ==============================================================================
# 오늘의 뚝딱 (Dduktak) 전역 환경변수 템플릿 (.env.example)
# 복사하여 .env 파일을 생성한 뒤 실제 환경에 맞는 값을 입력하세요.
# 주의: 실제 .env 파일은 .gitignore에 포함되어 절대 Git에 커밋되지 않습니다.
# ==============================================================================

# --- [Backend] PostgreSQL / Supabase Database Connection ---
# Supabase Transaction Pooler (Session/Transaction mode) 또는 직접 연결 설정
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.hefryhbaoovrhgzevfad
DB_PASSWORD=your_database_password_here

# --- [Backend] Spring Boot Server & Security ---
PORT=8080
# Supabase 대시보드 (Project Settings > API > JWT Settings > JWT Secret)
JWT_SECRET=your_supabase_jwt_secret_here

# --- [Backend] External Services (Gemini Flash & FoodQR) ---
# Google AI Studio Gemini API Key (영수증 OCR 품목 파싱용: POST /api/v1/inventory/scan-ocr)
# 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# (선택) 식품의약품안전처 푸드QR / 공공 데이터 API Key (바코드 식재료 조회용: GET /api/v1/inventory/barcode/{barcodeNo})
FOOD_QR_API_KEY=your_food_qr_api_key_here

# --- [Frontend] Supabase Client Direct Access ---
# 프로필 및 레시피 이미지 직접 업로드(Supabase Storage)를 위해 프론트엔드에 노출되는 공개 키
# (최신 Supabase Publishable Key: sb_publishable_... 권장 / 구버전 anon key도 호환 가능)
VITE_SUPABASE_URL=https://hefryhbaoovrhgzevfad.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# --- [Backend] Firebase Cloud Messaging (FCM 푸시 알림) ---
# Firebase 콘솔 (프로젝트 설정 > 서비스 계정 > '새 비공개 키 생성')에서 다운로드한 서비스 계정 키
# 1) 파일 경로 지정 방식 (로컬 개발 환경 권장 - 프로젝트 루트 기준 상대경로 또는 절대경로)
FIREBASE_SERVICE_ACCOUNT_PATH=backend/src/main/resources/firebase-service-account.json
# 2) JSON 문자열 직접 주입 방식 (Render/배포 환경 권장 - 단일 라인 JSON 또는 Base64 문자열)
# FIREBASE_SERVICE_ACCOUNT_JSON=your_service_account_json_content_here


