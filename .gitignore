# Root Git Ignore for '오늘의 뚝딱' Monorepo

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.iml

# Node / Frontend
node_modules/
dist/
*.tsbuildinfo
vite.config.js
vite.config.d.ts
.env
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java / Gradle / Backend
.gradle/
build/
bin/
out/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Sensitive Config
*.key
*.pem
secrets/
application-secret.yml
